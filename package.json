{
  "name": "nightdrive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nightdrive application foundation",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:check": "pwsh -NoProfile -File ./scripts/validate-docs.ps1",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run docs:check && npm run build"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@biomejs/biome": "2.5.12",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
